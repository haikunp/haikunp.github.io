---
import { COINS } from '../lib/coins';
import { PRICE_FEED } from '../lib/constants';

import type { PriceMap } from '../lib/prices';

interface Props {
  active?: string;        // selected coin symbol
  coinAmount?: number;    // pre-fill coin amount
  usdAmount?: number;     // pre-fill usd amount
  price?: number;         // baked price for the active coin (USD)
  prices?: PriceMap;      // baked prices for ALL coins (for switching)
  heading?: string;
  compact?: boolean;
}

const active = (Astro.props.active ?? COINS[0].symbol).toUpperCase();
const price = Astro.props.price;
const pricesJson = JSON.stringify(Astro.props.prices ?? {});
const priceStr = price != null ? String(price) : '';
const coinAmount = Astro.props.coinAmount ?? (Astro.props.usdAmount == null ? 1 : null);
const usdAmount = Astro.props.usdAmount ?? (coinAmount != null && price != null ? +(price * coinAmount).toFixed(2) : null);
const heading = Astro.props.heading;
---

<div class="convx" data-conv data-symbol={active}
     data-feed={PRICE_FEED.endpoint}
     data-prices={pricesJson}
     data-poll={(PRICE_FEED.pollSeconds * 1000)}
     data-cache={(PRICE_FEED.clientCacheSeconds * 1000)}>
  {heading && <h2 class="convx-title">{heading}</h2>}

  <div class="convx-grid">
    <label class="convx-field">
      <span>Coin</span>
      <div class="convx-coinwrap">
        <input class="convx-search" type="text" data-conv-search placeholder="Search coin…" autocomplete="off" aria-label="Search coin" />
        <select class="convx-select" data-conv-coin aria-label="Coin">
          {COINS.map((c) => (
            <option value={c.symbol} selected={c.symbol === active}>{c.name} ({c.symbol})</option>
          ))}
        </select>
      </div>
    </label>
    <label class="convx-field">
      <span>Amount in <b data-conv-symbol>{active}</b></span>
      <input class="convx-input" type="text" inputmode="decimal" data-conv-coin-amount
             value={coinAmount ?? ''} placeholder="0" autocomplete="off" />
    </label>
    <label class="convx-field">
      <span>Amount in USD</span>
      <input class="convx-input" type="text" inputmode="decimal" data-conv-usd-amount
             value={usdAmount ?? ''} placeholder="0" autocomplete="off" />
    </label>
  </div>

  <div class="convx-rate">
    <span class="convx-live" aria-hidden="true"></span>
    <span>1 <b data-conv-symbol>{active}</b> =</span>
    <span class="convx-price-wrap">$<input class="convx-price" type="text" inputmode="decimal"
      data-conv-price data-symbol={active} value={priceStr}
      aria-label="Price of one coin in USD" autocomplete="off" /></span>
    <span>USD</span>
  </div>
</div>

<script>
  // (Re)initialise every converter on the page. Idempotent.
  (function initConverters() {
    function num(v: string | null | undefined): number {
      if (v == null) return NaN;
      const n = parseFloat(String(v).replace(/[^0-9.\-]/g, ''));
      return isFinite(n) ? n : NaN;
    }
    function coinAmt(v: number): string {
      if (!isFinite(v)) return '';
      const max = v >= 1 ? 6 : 8;
      return v.toLocaleString('en-US', { maximumFractionDigits: max, useGrouping: false });
    }

    function setup(root: HTMLElement) {
      if (root.dataset.ready === '1') return;
      root.dataset.ready = '1';

      const sel = root.querySelector<HTMLSelectElement>('[data-conv-coin]')!;
      const search = root.querySelector<HTMLInputElement>('[data-conv-search]');
      const coinEl = root.querySelector<HTMLInputElement>('[data-conv-coin-amount]')!;
      const usdEl = root.querySelector<HTMLInputElement>('[data-conv-usd-amount]')!;
      const priceEl = root.querySelector<HTMLInputElement>('[data-conv-price]')!;
      const symbolEls = root.querySelectorAll<HTMLElement>('[data-conv-symbol]');

      let prices: Record<string, number> = {};
      try {
        const baked = JSON.parse(root.dataset.prices || '{}');
        if (baked && typeof baked === 'object') {
          for (const k of Object.keys(baked)) {
            if (typeof baked[k] === 'number') prices[k] = baked[k];
          }
        }
      } catch {}
      let manual: Record<string, boolean> = {};

      function symbol() { return sel.value; }
      function price(): number {
        const s = symbol();
        if (manual[s] && isFinite(num(priceEl.value))) return num(priceEl.value);
        if (prices[s] != null) return prices[s];
        return num(priceEl.value);
      }
      function setLabels(s: string) {
        symbolEls.forEach((el) => (el.textContent = s));
        root.dataset.symbol = s;
        priceEl.dataset.symbol = s;
      }
      function syncPrice() {
        const s = symbol();
        if (manual[s]) return;
        const p = prices[s];
        if (p != null) priceEl.value = String(p);
      }
      function recalc(from: 'coin' | 'usd') {
        const p = price();
        if (!isFinite(p) || p <= 0) return;
        if (from === 'usd') {
          const usd = num(usdEl.value);
          if (isFinite(usd)) coinEl.value = coinAmt(usd / p);
        } else {
          const c = num(coinEl.value);
          if (isFinite(c)) usdEl.value = coinAmt(c * p);
        }
      }

      coinEl.addEventListener('input', () => recalc('coin'));
      usdEl.addEventListener('input', () => recalc('usd'));
      priceEl.addEventListener('input', () => {
        manual[symbol()] = true;
        recalc('coin');
      });
      sel.addEventListener('change', () => {
        setLabels(symbol());
        syncPrice();
        recalc('coin');
      });
      if (search) {
        search.addEventListener('input', () => {
          const q = (search.value || '').trim().toLowerCase();
          let first: HTMLOptionElement | null = null;
          for (const opt of Array.from(sel.options)) {
            const match = !q || opt.textContent!.toLowerCase().includes(q);
            opt.hidden = !match;
            if (match && !first) first = opt;
          }
          if (q && first) {
            sel.value = first.value;
            setLabels(symbol());
            syncPrice();
            recalc('coin');
          }
        });
      }

      // live feed
      const endpoint = root.dataset.feed || '';
      const poll = Number(root.dataset.poll) || 15000;
      const cacheTtl = Number(root.dataset.cache) || 10000;
      const cacheKey = 'miniadda_prices_v1';
      function readCache(): Record<string, number> | null {
        try {
          const raw = localStorage.getItem(cacheKey);
          if (!raw) return null;
          const obj = JSON.parse(raw);
          if (!obj || !obj.ts || Date.now() - obj.ts > cacheTtl) return null;
          return obj.data;
        } catch { return null; }
      }
      function writeCache(data: Record<string, number>) {
        try { localStorage.setItem(cacheKey, JSON.stringify({ ts: Date.now(), data })); } catch {}
      }
      function apply(p: Record<string, number>) {
        if (!p || typeof p !== 'object') return;
        prices = p;
        syncPrice();
        recalc('coin');
      }
      async function fetchPrices() {
        if (!endpoint) return;
        const cached = readCache();
        if (cached) { apply(cached); return; }
        try {
          const r = await fetch(endpoint + (endpoint.includes('?') ? '&' : '?') + 't=' + Date.now(), { cache: 'no-store' });
          if (!r.ok) return;
          const data = await r.json();
          const p = data.prices || data;
          if (p && typeof p === 'object') { apply(p); writeCache(p); }
        } catch {}
      }
      syncPrice();
      recalc('coin');
      fetchPrices();
      if (endpoint) setInterval(fetchPrices, poll);
    }

    function boot() {
      document.querySelectorAll<HTMLElement>('[data-conv]').forEach(setup);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
    document.addEventListener('astro:page-load', boot);
  })();
</script>
