---
import { topicLabel } from '../lib/constants';
import { articleUrl, formatDate, type Article } from '../lib/content';

interface Props {
  article: Article;
  featured?: boolean;
}
const { article, featured = false } = Astro.props;
const { data } = article;
---
<a class:list={['article-card', featured && 'is-featured']} href={articleUrl(article)}>
  <div class="card-top">
    <span class="topic-pill">{topicLabel(data.topic)}</span>
    <span class="tag-pill">{data.kind === 'news' ? 'News' : 'Article'}</span>
  </div>
  <h3>{data.title}</h3>
  <p>{data.answer}</p>
  <div class="card-meta">
    <span>{formatDate(data.publishedAt)}</span>
    <span class="dot" aria-hidden="true"></span>
    <span>{data.author}</span>
  </div>
</a>
