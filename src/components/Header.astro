---
import { SITE } from '../lib/constants';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="MiniAdda home">
      <span class="logo-mark" aria-hidden="true">M</span>
      {SITE.name}
    </a>
    <nav class="section-nav" aria-label="Sections">
      <a href="/prices" aria-current={path.startsWith('/prices') ? 'page' : undefined}>Prices</a>
      <a href="/sigcamp" aria-current={path.startsWith('/sigcamp') ? 'page' : undefined}>Sigcamp</a>
      <a href="/us" aria-current={path.startsWith('/us') || path.startsWith('/international') ? 'page' : undefined}>News</a>
    </nav>
  </div>
</header>
