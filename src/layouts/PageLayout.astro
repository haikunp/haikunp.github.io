---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, type, publishedAt, updatedAt, author, noindex, jsonLd } =
  Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  path={Astro.url.pathname}
  image={image}
  type={type}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  author={author}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>
