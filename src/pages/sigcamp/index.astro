---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllSigCamp, sigCampUrl } from '../../lib/content';
import { breadcrumbList } from '../../lib/seo';

const campaigns = await getAllSigCamp();
const active = campaigns.filter((c) => c.data.status === 'active');
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Sigcamp', url: '/sigcamp' },
];
const title = 'Sigcamp — Active BitcoinTalk Signature Campaigns';
const description =
  'Browse active BitcoinTalk signature campaigns in one place: rewards, slots and threads. Find a signature campaign to join.';
const ld = [breadcrumbList(crumbs)];
---
<PageLayout title={title} description={description} path="/sigcamp" jsonLd={ld}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="page-header">
      <h1>Sigcamp</h1>
      <p>{active.length} active signature campaign{active.length === 1 ? '' : 's'} on BitcoinTalk</p>
    </header>

    <section class="section section--first">
      {campaigns.length ? (
        <div class="card-grid">
          {campaigns.map((c) => (
            <a class="article-card" href={sigCampUrl(c)}>
              <div class="card-top">
                <span class="topic-pill">{c.data.status}</span>
                {c.data.tags.slice(0, 2).map((t) => <span class="tag-pill">{t}</span>)}
              </div>
              <h3>{c.data.project}</h3>
              <p>{c.data.description}</p>
              <div class="card-meta">
                <span>{c.data.reward}</span>
                {c.data.slots && <><span class="dot" aria-hidden="true"></span><span>{c.data.slots}</span></>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">No campaigns listed yet.</p>
      )}
    </section>
  </div>
</PageLayout>
