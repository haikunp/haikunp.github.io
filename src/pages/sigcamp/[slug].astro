---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllSigCamp, sigCampUrl } from '../../lib/content';
import { breadcrumbList } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const campaigns = await getAllSigCamp();
  return campaigns.map((camp) => ({ params: { slug: camp.id }, props: { camp } }));
}) satisfies GetStaticPaths;

const { camp } = Astro.props;
const { Content } = await render(camp);
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Sigcamp', url: '/sigcamp' },
  { name: camp.data.project, url: sigCampUrl(camp) },
];
const title = `${camp.data.project} — Signature Campaign | Sigcamp`;
const description = camp.data.description;
const ld = [breadcrumbList(crumbs)];
---
<PageLayout title={title} description={description} path={sigCampUrl(camp)} jsonLd={ld}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="article-header">
      <div class="card-top">
        <span class="topic-pill">{camp.data.status}</span>
        {camp.data.tags.map((t) => <span class="tag-pill">{t}</span>)}
      </div>
      <h1>{camp.data.project}</h1>
      <div class="article-meta">
        <span>Reward: {camp.data.reward}</span>
        {camp.data.slots && <><span class="dot" aria-hidden="true"></span><span>{camp.data.slots}</span></>}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {camp.data.threadUrl && (
      <p class="verified">
        <a href={camp.data.threadUrl} target="_blank" rel="nofollow noopener noreferrer">Open BitcoinTalk thread →</a>
      </p>
    )}
  </div>
</PageLayout>
