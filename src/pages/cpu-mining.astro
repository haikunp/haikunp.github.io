---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCpuCoins, cell, list } from '../lib/table';

const rows = getCpuCoins();
const metaDescription =
  'Coins you can still mine on a normal CPU: name, symbol, algorithm, plus pools and exchanges for each coin, all in one simple table.';
function host(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---
<BaseLayout title="CPU Mining Coins" description={metaDescription} path="/cpu-mining">
  <div class="container page">
    <a class="back-link" href="/">← MiniAdda</a>
    <h1 class="page-title">CPU Mining Coins</h1>
    <p class="page-sub">
      {rows.length} coin{rows.length === 1 ? '' : 's'} you can mine on a normal CPU.
    </p>

    {rows.length ? (
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Coin</th>
              <th scope="col">Symbol</th>
              <th scope="col">Algorithm</th>
              <th scope="col">Pools</th>
              <th scope="col">Exchanges</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => {
              const pools = list(r, 'pool');
              const exchanges = list(r, 'exchange');
              return (
                <tr>
                  <td class="serial">{r.serial}</td>
                  <td>{cell(r, 'name')}</td>
                  <td>{cell(r, 'symbol') || '—'}</td>
                  <td>{cell(r, 'algorithm') || '—'}</td>
                  <td>
                    {pools.length ? (
                      <ul class="link-list">
                        {pools.map((u) => (
                          <li>
                            <a href={u} target="_blank" rel="nofollow noopener noreferrer">{host(u)}</a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      '—'
                    )}
                  </td>
                  <td>
                    {exchanges.length ? (
                      <ul class="link-list">
                        {exchanges.map((u) => (
                          <li>
                            <a href={u} target="_blank" rel="nofollow noopener noreferrer">{host(u)}</a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      '—'
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="empty">No coins listed yet.</p>
    )}
  </div>
</BaseLayout>
