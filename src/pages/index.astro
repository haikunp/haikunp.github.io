---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';

const tools = [
  {
    href: '/crypto-price',
    title: 'Crypto Price',
    desc: 'Convert crypto ↔ USD with live prices.',
  },
  {
    href: '/sigcamp',
    title: 'Signature Campaigns',
    desc: 'BitcoinTalk signature campaigns in one simple table.',
  },
  {
    href: '/cpu-mining',
    title: 'CPU Mining Coins',
    desc: 'Coins you can still mine on a normal CPU.',
  },
];

const metaDescription =
  'MiniAdda — simple, useful tools: live crypto prices, BitcoinTalk signature campaigns and CPU-mineable coins.';
---
<BaseLayout title="MiniAdda" description={metaDescription} path="/">
  <div class="container">
    <header class="home-head">
      <h1>{SITE.name}</h1>
      <p>{SITE.tagline}</p>
    </header>

    <nav aria-label="Tools">
      <div class="tool-grid">
        {tools.map((t) => (
          <a class="tool-card" href={t.href}>
            <h2>{t.title}</h2>
            <p>{t.desc}</p>
            <span class="go">Open →</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</BaseLayout>
