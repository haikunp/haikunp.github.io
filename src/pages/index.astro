---
import PageLayout from '../layouts/PageLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PriceConverter from '../components/PriceConverter.astro';
import { SITE, TOPICS } from '../lib/constants';
import { COINS } from '../lib/coins';
import { fetchPrices, fmtUsd } from '../lib/prices';
import { getAllArticles, articleUrl } from '../lib/content';
import { itemListSchema } from '../lib/seo';

const { prices } = await fetchPrices();
const articles = await getAllArticles();
const latest = articles.slice(0, 3);
const first = COINS[0];

const homeLd = itemListSchema(latest, { name: 'Latest on MiniAdda', url: '/' });
const metaTitle = `${SITE.name} — Crypto Prices, Converters & Quick Answers`;
const metaDescription =
  'Live crypto prices, instant USD converters and quick answers. Bitcoin, Ethereum, TRON and more — plus the day’s crypto news and active BitcoinTalk signature campaigns.';
---
<PageLayout title={metaTitle} description={metaDescription} path="/" jsonLd={homeLd}>
  <section class="section section--first" aria-labelledby="tool-heading">
    <div class="container">
      <header class="page-header">
        <h1 id="tool-heading">Crypto to USD Converter</h1>
        <p>Pick a coin, convert both ways, check live prices.</p>
      </header>
      <PriceConverter active={first.symbol} price={prices[first.symbol]} prices={prices} />
    </div>
  </section>

  <section class="section" aria-labelledby="prices-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="prices-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>Live prices</h2>
        <a href="/prices">All prices →</a>
      </div>
      <table class="price-table">
        <thead><tr><th>Coin</th><th>Price (USD)</th></tr></thead>
        <tbody>
          {COINS.map((c) => (
            <tr>
              <td><a href={`/prices/${c.name.toLowerCase()}-to-usd`}>{c.name} ({c.symbol})</a></td>
              <td>{fmtUsd(prices[c.symbol])}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" aria-labelledby="articles-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="articles-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>Crypto news</h2>
        <a href="/us">More →</a>
      </div>
      {latest.length ? (
        <div class="card-grid">
          {latest.map((a) => <ArticleCard article={a} />)}
        </div>
      ) : (
        <p class="empty-state">No articles yet. Check back soon.</p>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="sigcamp-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="sigcamp-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>Signature campaigns</h2>
        <a href="/sigcamp">View all →</a>
      </div>
      <p class="empty-state">Active BitcoinTalk signature campaigns — <a href="/sigcamp">browse Sigcamp</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="topics-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="topics-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>By topic</h2>
      </div>
      <div class="chip-row">
        {TOPICS.map((t) => <a class="chip" href={`/topics/${t.slug}`}>{t.name}</a>)}
      </div>
    </div>
  </section>
</PageLayout>
