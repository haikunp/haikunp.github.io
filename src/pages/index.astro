---
import PageLayout from '../layouts/PageLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, REGIONS, TOPICS } from '../lib/constants';
import {
  getAllArticles,
  getSectionArticles,
  articleUrl,
  tagCounts,
} from '../lib/content';
import { itemListSchema } from '../lib/seo';

const articles = await getAllArticles();
const us = await getSectionArticles('us');
const international = await getSectionArticles('international');

const trending = articles.filter((a) => a.data.trending).slice(0, 6);
const trendingList = (trending.length ? trending : articles).slice(0, 6);
const latest = articles.slice(0, 6);

const counts = tagCounts(articles);
const activeTags = REGIONS.filter((r) => (counts.get(r.slug) ?? 0) > 0);

const homeLd = itemListSchema(trendingList, {
  name: 'Trending questions on MiniAdda',
  url: '/',
});

const metaTitle = `${SITE.name} — ${SITE.tagline}`;
const metaDescription = SITE.description;
---
<PageLayout title={metaTitle} description={metaDescription} path="/" jsonLd={homeLd}>
  <section class="ticker" aria-label="Search">
    <div class="container">
      <SearchBar placeholder="What are you curious about?" />
    </div>
  </section>

  <section class="section section--first" aria-labelledby="trending-heading">
    <div class="container">
      <div class="section-head">
        <h1 id="trending-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>Trending right now</h1>
      </div>
      {trendingList.length > 0 ? (
        <ol class="trending-list">
          {trendingList.map((a) => (
            <li><a href={articleUrl(a)}>{a.data.title}</a></li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">No answers yet. Check back soon.</p>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="us-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="us-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>US</h2>
        <a href="/us">See all →</a>
      </div>
      {us.length ? (
        <div class="card-grid">
          {us.slice(0, 3).map((a, i) => <ArticleCard article={a} featured={i === 0} />)}
        </div>
      ) : (
        <p class="empty-state">Nothing here yet.</p>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="intl-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="intl-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>International</h2>
        <a href="/international">See all →</a>
      </div>
      {international.length ? (
        <div class="card-grid">
          {international.slice(0, 3).map((a, i) => <ArticleCard article={a} featured={i === 0} />)}
        </div>
      ) : (
        <p class="empty-state">Nothing here yet.</p>
      )}
    </div>
  </section>

  {activeTags.length > 0 && (
    <section class="section" aria-labelledby="tags-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="tags-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>Jump to a place</h2>
        </div>
        <div class="chip-row">
          {activeTags.map((r) => (
            <a class="chip" href={`/tags/${r.slug}`}>
              {r.name}
              <span class="count">{counts.get(r.slug)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="topics-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="topics-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>By topic</h2>
      </div>
      <div class="chip-row">
        {TOPICS.map((t) => (
          <a class="chip" href={`/topics/${t.slug}`}>{t.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="latest-heading" class="section-title"><span class="tag-bar" aria-hidden="true"></span>Latest answers</h2>
      </div>
      {latest.length ? (
        <div class="card-grid">
          {latest.map((a) => <ArticleCard article={a} />)}
        </div>
      ) : (
        <p class="empty-state">No answers yet. Check back soon.</p>
      )}
    </div>
  </section>
</PageLayout>
