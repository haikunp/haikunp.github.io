---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSigcamp, cell } from '../lib/table';

const rows = getSigcamp();
const metaDescription =
  'Browse BitcoinTalk signature campaigns in one simple table: campaign name, manager, payment per post and a link to each thread.';
---
<BaseLayout title="Signature Campaigns" description={metaDescription} path="/sigcamp">
  <div class="container page">
    <a class="back-link" href="/">← MiniAdda</a>
    <h1 class="page-title">Signature Campaigns</h1>
    <p class="page-sub">
      {rows.length} BitcoinTalk campaign{rows.length === 1 ? '' : 's'}.
    </p>

    {rows.length ? (
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Name</th>
              <th scope="col">Manager</th>
              <th scope="col">Payment</th>
              <th scope="col">Link</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="serial">{r.serial}</td>
                <td>{cell(r, 'name')}</td>
                <td>{cell(r, 'manager') || '—'}</td>
                <td>{cell(r, 'payment') || '—'}</td>
                <td>
                  {r.link ? (
                    <a class="btn" href={cell(r, 'link')} target="_blank" rel="nofollow noopener noreferrer">
                      Visit
                    </a>
                  ) : (
                    '—'
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="empty">No campaigns listed yet.</p>
    )}
  </div>
</BaseLayout>
