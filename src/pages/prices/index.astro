---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PriceConverter from '../../components/PriceConverter.astro';
import { COINS } from '../../lib/coins';
import { fetchPrices, fmtUsd } from '../../lib/prices';
import { breadcrumbList } from '../../lib/seo';

const { prices } = await fetchPrices();
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Prices', url: '/prices' },
];
const title = 'Crypto Prices & USD Converter';
const description =
  'Live crypto prices in USD and a two-way converter. Convert Bitcoin, Ethereum, TRON, Tether, BNB and more to USD and back — instantly.';
const ld = [breadcrumbList(crumbs)];
const first = COINS[0];
---
<PageLayout title={title} description={description} path="/prices" jsonLd={ld}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="page-header">
      <h1>Crypto Prices &amp; Converter</h1>
      <p>Pick a coin, convert both ways, and see the live rate.</p>
    </header>

    <section class="section section--first">
      <PriceConverter active={first.symbol} price={prices[first.symbol]} prices={prices} heading="Convert crypto ↔ USD" />
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="section-title"><span class="tag-bar" aria-hidden="true"></span>Live prices</h2>
      </div>
      <table class="price-table">
        <thead>
          <tr><th>Coin</th><th>Price (USD)</th></tr>
        </thead>
        <tbody>
          {COINS.map((c) => (
            <tr>
              <td><a href={`/prices/${c.name.toLowerCase()}-to-usd`}>{c.name} ({c.symbol})</a></td>
              <td data-live-price={c.symbol}>{fmtUsd(prices[c.symbol])}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="section-title"><span class="tag-bar" aria-hidden="true"></span>Popular conversions</h2>
      </div>
      <div class="chip-row">
        {COINS.flatMap((c) => [
          <a class="chip" href={`/prices/price-of-1-${c.symbol.toLowerCase()}`}>Price of 1 {c.symbol}</a>,
          <a class="chip" href={`/prices/${c.name.toLowerCase()}-to-usd`}>{c.symbol} to USD</a>,
        ])}
      </div>
    </section>
  </div>
</PageLayout>
