---
import PageLayout from '../layouts/PageLayout.astro';
import SearchBar from '../components/SearchBar.astro';
---
<PageLayout
  title="Search"
  description="Search MiniAdda for quick answers to trending questions."
  noindex={true}
>
  <div class="container">
    <header class="page-header">
      <h1>Search</h1>
      <p id="search-status">Find a quick answer.</p>
    </header>
    <div style="max-width:560px;margin:24px 0 8px">
      <SearchBar />
    </div>
    <section class="section">
      <div id="search-results" class="card-grid"></div>
    </section>
  </div>
</PageLayout>

<script>
  interface IndexEntry {
    title: string;
    answer: string;
    description: string;
    topic: string;
    section: string;
    tags: string[];
    url: string;
    publishedAt: string;
  }

  const statusEl = document.getElementById('search-status');
  const resultsEl = document.getElementById('search-results');
  const params = new URLSearchParams(location.search);
  const q = (params.get('q') ?? '').trim();
  const input = document.querySelector<HTMLInputElement>('.search-form input');
  if (input) input.value = q;

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function renderCard(a: IndexEntry): string {
    return `<a class="article-card" href="${a.url}">
      <div class="card-top"><span class="topic-pill">${esc(a.topic)}</span></div>
      <h3>${esc(a.title)}</h3>
      <p>${esc(a.answer)}</p>
    </a>`;
  }

  if (q) {
    fetch('/search-index.json')
      .then((r) => r.json() as Promise<IndexEntry[]>)
      .then((data) => {
        const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
        const results = data.filter((a) => {
          const hay = `${a.title} ${a.answer} ${a.description} ${a.topic} ${a.section} ${a.tags.join(' ')}`.toLowerCase();
          return terms.every((t) => hay.includes(t));
        });
        if (statusEl)
          statusEl.textContent = `${results.length} result${results.length === 1 ? '' : 's'} for “${q}”`;
        if (resultsEl)
          resultsEl.innerHTML = results.length
            ? results.map(renderCard).join('')
            : '<p class="empty-state">No answers matched. Try a different search.</p>';
      })
      .catch(() => {
        if (statusEl) statusEl.textContent = 'Search is temporarily unavailable.';
      });
  }
</script>
