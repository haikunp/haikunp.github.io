---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRICE_FEED } from '../../lib/constants';
import { CONVERSION_AMOUNTS, STATIC_PAGES_TOP, coinSlug } from '../../lib/coins';
import { getCoins } from '../../lib/table';
import { fetchPrices, fmtUsd } from '../../lib/prices';

export function getStaticPaths() {
  const rows = getCoins().slice(0, STATIC_PAGES_TOP);
  const paths: { params: { slug: string }; props: { amount: string; symbol: string; name: string } }[] = [];
  for (const r of rows) {
    const symbol = String(r.symbol);
    const name = String(r.name);
    const slugs = Array.from(new Set([coinSlug({ name }), symbol.toLowerCase()]));
    for (const base of slugs) {
      for (const amount of CONVERSION_AMOUNTS) {
        paths.push({
          params: { slug: `${amount}-${base}-to-usd` },
          props: { amount: String(amount), symbol, name },
        });
      }
    }
  }
  return paths;
}

const { amount, symbol, name } = Astro.props;
const { prices } = await fetchPrices();
const price = prices[symbol];
const amountNum = parseFloat(amount);
const result = price != null && isFinite(amountNum) ? amountNum * price : null;
const title = `${amount} ${symbol} to USD`;
const metaDescription =
  result != null
    ? `${amount} ${name} (${symbol}) = ${fmtUsd(result)} USD. Convert ${name} to USD with live prices.`
    : `Convert ${amount} ${name} (${symbol}) to USD with live prices.`;

const related = CONVERSION_AMOUNTS.filter((a) => String(a) !== amount).slice(0, 5);
const slugBase = coinSlug({ name });
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: metaDescription,
  url: `https://miniadda.com/convert/${amount}-${slugBase}-to-usd`,
};
---
<BaseLayout title={title} description={metaDescription} path={`/convert/${amount}-${slugBase}-to-usd`}>
  <div class="container page">
    <a class="back-link" href="/crypto-price?coin={symbol}">← Converter</a>
    <h1 class="page-title">{amount} {name} to USD</h1>
    <p class="page-sub">Live conversion at the current {symbol} price.</p>

    <section
      class="panel"
      data-live
      data-symbol={symbol}
      data-amount={amount}
      data-feed={PRICE_FEED.endpoint}
    >
      <p class="conv-result">
        <span>{amount}</span> <b>{symbol}</b> = <strong data-live-usd>{result != null ? fmtUsd(result) : '—'}</strong> USD
      </p>
      <p class="conv-rate">1 <b>{symbol}</b> = <span data-live-rate>{fmtUsd(price)}</span> USD <span class="badge up">live</span></p>
      <p class="page-sub" style="margin-top:14px">
        Convert any amount on the <a href="/crypto-price?coin={symbol}">converter</a>, or browse <a href="/crypto-prices">all prices</a>.
      </p>
    </section>

    <section class="panel">
      <h2>Other {symbol} conversions</h2>
      <div class="chips">
        {related.map((a) => (
          <a class="chip" href={`/convert/${a}-${slugBase}-to-usd`}>{a} {symbol} → USD</a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline define:vars={{ feed: PRICE_FEED.endpoint, symbol: symbol }}>
  (function liveConvert() {
    const root = document.querySelector('[data-live]');
    if (!root) return;
    const amount = Number(root.dataset.amount || '0');
    const usdEl = root.querySelector('[data-live-usd]');
    const rateEl = root.querySelector('[data-live-rate]');
    function fmt(v) {
      if (!isFinite(v)) return '—';
      const max = v < 1 ? 8 : 2;
      return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: max });
    }
    async function refresh() {
      if (!feed) return;
      try {
        const r = await fetch(feed + (feed.includes('?') ? '&' : '?') + 't=' + Date.now(), { cache: 'no-store' });
        if (!r.ok) return;
        const d = await r.json();
        const p = (d.prices || d)[symbol];
        if (typeof p !== 'number') return;
        if (usdEl) usdEl.textContent = fmt(amount * p);
        if (rateEl) rateEl.textContent = fmt(p);
      } catch {}
    }
    refresh();
    setInterval(refresh, 5000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  })();
</script>

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
