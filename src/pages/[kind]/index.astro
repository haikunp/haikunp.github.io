---
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { KINDS, kindName } from '../../lib/constants';
import { getByKind } from '../../lib/content';
import { breadcrumbList, itemListSchema, webPageSchema } from '../../lib/seo';

export const getStaticPaths = (async () => {
  return KINDS.map((k) => ({ params: { kind: k.slug }, props: { slug: k.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.props;
const name = kindName(slug);
const items = await getByKind(slug as 'news' | 'article');
const crumbs = [
  { name: 'Home', url: '/' },
  { name, url: `/${slug}` },
];
const description =
  slug === 'news'
    ? 'The latest crypto news on MiniAdda — short, sourced and updated regularly.'
    : 'In-depth crypto articles and explainers on MiniAdda.';
const ld = [
  itemListSchema(items, { name: `${name} on MiniAdda`, url: `/${slug}` }),
  breadcrumbList(crumbs),
  webPageSchema({ name: `${name} — MiniAdda`, description, url: `/${slug}` }),
];
---
<PageLayout title={`${name} — Crypto ${name}`} description={description} path={`/${slug}`} jsonLd={ld}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="page-header">
      <h1>{name}</h1>
      <p>{items.length} stor{items.length === 1 ? 'y' : 'ies'}</p>
    </header>
    <section class="section">
      {items.length ? (
        <div class="card-grid">
          {items.map((a, i) => <ArticleCard article={a} featured={i === 0} />)}
        </div>
      ) : (
        <p class="empty-state">No {name.toLowerCase()} yet.</p>
      )}
    </section>
  </div>
</PageLayout>
